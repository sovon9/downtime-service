directive @lookup on FIELD_DEFINITION
directive @internal on FIELD_DEFINITION
directive @sharable on INTERFACE | OBJECT | FIELD_DEFINITION

type Query
{
    downtimeEvents(where: DowntimeEventFilter, first: Int, last: Int, before: String, after: String, order: DowntimeEventOrder): DowntimeEventConnection

    downtimeEventsById(downtimeId: [Float!]): [DowntimeEvent] @lookup @internal
}

type PageInfo
{
    endCursor: String
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
    startCursor: String
}

type DowntimeEventConnection
{
    edges: [DowntimeEventEdge]
    pageInfo: PageInfo!
}

type DowntimeEventEdge
{
    node: DowntimeEvent
    cursor: String!
}

type DowntimeEvent implements Node @sharable
{
    id: ID!
    downtimeId: ID
    productionUnitId: Float
    productionUnit: ProductionUnit @lookup
    processOrderId: Float
    processOrder: ProcessOrder @lookup
    startTime: String!
    endTime: String
    durationMinutes: Float
    downtimeReasonId: Int
    reason: DowntimeReason
    isPlanned: Boolean
    comments: String
    createdAt: String
}

type DowntimeReason
{
    downtimeReasonId: ID
    reasonCode: String
    reasonDescription: String
    categoryId: Int
    category: DowntimeCategory
}

type DowntimeCategory
{
    categoryId: ID
    categoryName: String
    isPlanned: Boolean
}

input DowntimeEventFilter
{
    and: [DowntimeEventFilter]
    or: [DowntimeEventFilter]
    downtimeId: ID
    productionUnitId: Float
    processOrderId: Float
    startTime: String
    endTime: String
    isPlanned: Boolean
    downtimeReasonId: Int
    reason: DowntimeReasonFilter
}

input DowntimeReasonFilter
{
    downtimeReasonId: ID
    reasonCode: String
    reasonDescription: String
    categoryId: Int
    category: DowntimeCategoryFilter
}

input DowntimeCategoryFilter
{
    categoryId: ID
    categoryName: String
    isPlanned: Boolean
}

input DowntimeEventOrder
{
    downtimeId: SortOrder
    productionUnitId: SortOrder
    startTime: SortOrder
    endTime: SortOrder
    durationMinutes: SortOrder
    isPlanned: SortOrder
    reason: DowntimeReasonOrder
}

input DowntimeReasonOrder
{
    downtimeReasonId: SortOrder
    reasonCode: SortOrder
    reasonDescription: SortOrder
}

enum SortOrder
{
    ASC
    DESC
}

interface Node @sharable
{
    id: ID!
}

# Cross-service stubs resolved via federation
type ProductionUnit
{
    productionUnitId: Float
}

type ProcessOrder
{
    processOrderId: Float
}
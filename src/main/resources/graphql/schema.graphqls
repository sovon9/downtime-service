{

}

input downtimeEventOrder
{

}

type DowntimeEventConnection
{
    edges: [DwontimeEventEdge]
    pageinfo: PageInfo!
}

type DwontimeEventEdge
{
    node: DowntimeEvent
    cursor: String!
}

